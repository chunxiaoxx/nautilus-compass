# compass v1.0 · self-host environment template
# Copy to .env and fill in secrets · DO NOT commit .env

# ========== REQUIRED ==========

# JWT secret · shared with nautilus.social if integrating · 32+ random bytes recommended
# Generate: openssl rand -base64 32
NAUTILUS_JWT_SECRET=CHANGE_ME_TO_RANDOM_SECRET

# ========== OPTIONAL · region ==========

# cn-shanghai | eu-frankfurt | us-virginia
COMPASS_REGION=cn-shanghai

# ========== OPTIONAL · LLM provider for session_writer ==========

# Volc Ark coding plan (¥0.05/session)
ARK_API_KEY=
COMPASS_WRITER_MODEL=deepseek-v3.2
COMPASS_WRITER_PROVIDER=ark

# Or Anthropic / DeepSeek official (more expensive)
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=

# ========== OPTIONAL · GPU ==========

# Set to "cuda" if NVIDIA GPU available · "cpu" otherwise (50-200x slower)
ZMM_DEVICE=cpu

# HF model mirror (faster in China · use https://huggingface.co outside)
HF_ENDPOINT=https://hf-mirror.com

# ========== OPTIONAL · ports ==========

COMPASS_API_PORT=8765
COMPASS_API_WORKERS=4
HTTP_PORT=80
HTTPS_PORT=443

# ========== OPTIONAL · scale (Postgres + Redis) ==========

# Only set if using --profile scale
POSTGRES_PASSWORD=

# ========== OPTIONAL · Nautilus integration ==========

# Stake event A2A endpoint (only if integrating with Nautilus stake module)
NAUTILUS_STAKE_URL=https://a2a-registry.nautilus.social/a2a/messages
NAUTILUS_API_TOKEN=
