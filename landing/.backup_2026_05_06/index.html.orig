<style>
  :root {
    --fg: #0a0a0a;
    --muted: #555;
    --bg: #fff;
    --bg-soft: #fafafa;
    --line: #e5e5e5;
    --accent: #1d6cf3;
    --green: #10a960;
    --orange: #e94e1b;
    --code-bg: #f4f4f4;
    --code-fg: #0a0a0a;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
                 "Microsoft YaHei", "Noto Sans CJK SC", Arial, sans-serif;
    color: var(--fg);
    background: var(--bg);
    line-height: 1.65;
    font-size: 16px;
  }
  .wrap { max-width: 980px; margin: 0 auto; padding: 56px 24px; }
  h1 { font-size: 56px; line-height: 1.1; margin: 0 0 24px; font-weight: 800;
       letter-spacing: -0.025em; }
  h2 { font-size: 32px; margin: 64px 0 20px; font-weight: 700;
       letter-spacing: -0.015em; }
  h3 { font-size: 20px; margin: 32px 0 12px; font-weight: 600; }
  .lead { font-size: 22px; color: var(--muted); margin: 0 0 32px;
          line-height: 1.5; }
  .badges { display: flex; flex-wrap: wrap; gap: 8px; margin: 24px 0 40px; }
  .badge { display: inline-block; padding: 6px 12px; border-radius: 100px;
           font-size: 13px; font-weight: 600; }
  .b-green { background: #d1f4e0; color: #00684a; }
  .b-blue { background: #d6e4ff; color: #1d4ed8; }
  .b-orange { background: #ffe4d1; color: #c2410c; }
  .b-gray { background: #e5e5e5; color: #404040; }
  .cta-row { display: flex; gap: 12px; flex-wrap: wrap; margin: 32px 0; }
  .cta { display: inline-block; padding: 14px 28px; border-radius: 8px;
         text-decoration: none; font-weight: 600; font-size: 16px;
         transition: 0.15s; }
  .cta-primary { background: var(--accent); color: #fff; }
  .cta-primary:hover { background: #1856c7; }
  .cta-secondary { background: var(--code-bg); color: var(--fg);
                   border: 1px solid var(--line); }
  .cta-secondary:hover { background: var(--line); }

  pre { background: var(--code-bg); padding: 16px 20px; border-radius: 8px;
        overflow-x: auto; font-family: ui-monospace, "SF Mono", Menlo, Consolas,
        monospace; font-size: 14px; line-height: 1.5;
        border: 1px solid var(--line); }
  code { background: var(--code-bg); padding: 2px 6px; border-radius: 4px;
         font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 13px; }
  pre code { background: none; padding: 0; font-size: 14px; }

  table { width: 100%; border-collapse: collapse; margin: 16px 0;
          font-size: 14px; }
  th, td { text-align: left; padding: 10px 12px; border: 1px solid var(--line); }
  th { background: var(--bg-soft); font-weight: 600; }
  tr:nth-child(even) td { background: var(--bg-soft); }
  td.center { text-align: center; }
  .num-big { font-size: 32px; font-weight: 800; color: var(--accent);
             font-feature-settings: "tnum"; }
  .num-mid { font-size: 18px; font-weight: 700; }

  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;
           margin: 32px 0; }
  @media (max-width: 700px) { .stats { grid-template-columns: repeat(2, 1fr); } }
  .stat { padding: 24px; border: 1px solid var(--line); border-radius: 12px;
          text-align: center; background: var(--bg-soft); }
  .stat-num { font-size: 36px; font-weight: 800; color: var(--accent);
              line-height: 1; margin-bottom: 8px;
              font-feature-settings: "tnum"; }
  .stat-label { font-size: 14px; color: var(--muted); }

  ul.feat { list-style: none; padding: 0; margin: 16px 0; }
  ul.feat li { padding: 14px 16px; border-bottom: 1px solid var(--line);
               display: grid; grid-template-columns: 24px 1fr; gap: 12px;
               align-items: start; }
  ul.feat li:last-child { border: 0; }
  ul.feat .icon { font-weight: 800; color: var(--accent); }
  ul.feat b { display: inline; }

  .columns { display: grid; grid-template-columns: 1fr 1fr; gap: 24px;
             margin: 24px 0; }
  @media (max-width: 700px) { .columns { grid-template-columns: 1fr; } }
  .col { padding: 24px; background: var(--bg-soft); border-radius: 12px;
         border: 1px solid var(--line); }

  .compare { display: grid; grid-template-columns: 1fr 1.5fr; gap: 0;
             margin: 24px 0; border: 1px solid var(--line); border-radius: 12px;
             overflow: hidden; }
  .compare-row { display: contents; }
  .compare-row > div { padding: 16px 20px; border-bottom: 1px solid var(--line); }
  .compare-row:last-child > div { border-bottom: 0; }
  .compare-label { background: var(--bg-soft); font-weight: 600; }
  .compare-value { font-feature-settings: "tnum"; }
  .compare-row.highlight .compare-value { background: #d1f4e0; font-weight: 600; }

  .pricing { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;
             margin: 24px 0; }
  @media (max-width: 900px) { .pricing { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .pricing { grid-template-columns: 1fr; } }
  .price-card { padding: 24px; border: 1px solid var(--line); border-radius: 12px;
                background: var(--bg-soft); }
  .price-card.featured { border: 2px solid var(--accent); background: #fff;
                          box-shadow: 0 4px 24px rgba(29, 108, 243, 0.1); }
  .price-name { font-size: 18px; font-weight: 700; margin-bottom: 4px; }
  .price-num { font-size: 28px; font-weight: 800; color: var(--accent);
                margin: 8px 0 12px; font-feature-settings: "tnum"; }
  .price-num small { font-size: 14px; color: var(--muted); font-weight: 400; }
  .price-list { list-style: none; padding: 0; font-size: 14px; }
  .price-list li { padding: 4px 0; }
  .price-list li::before { content: "✓"; color: var(--green); margin-right: 8px;
                            font-weight: 700; }
  .price-list li.no::before { content: "—"; color: var(--muted); }

  footer { margin: 96px 0 24px; padding-top: 32px; border-top: 1px solid var(--line);
           color: var(--muted); font-size: 14px; }
  footer a { color: var(--muted); }
  .nav { display: flex; gap: 24px; flex-wrap: wrap; margin-bottom: 16px; }
  .alert { padding: 16px 20px; border-radius: 8px; background: #fff5e8;
            border: 1px solid #ffd591; margin: 24px 0; font-size: 14px; }
  .negative { padding: 16px 20px; border-radius: 8px; background: #fff1f0;
               border: 1px solid #ffccc7; margin: 16px 0; font-size: 14px; }

  .tab-nav { display: flex; gap: 4px; margin-bottom: 16px; flex-wrap: wrap; }
  .tab { padding: 10px 16px; background: var(--bg-soft); border: 1px solid var(--line);
         border-radius: 8px 8px 0 0; cursor: pointer; user-select: none;
         font-size: 14px; font-weight: 600; }
  .tab.active { background: var(--code-bg); color: var(--accent); border-bottom: 0; }
  .tab-content { display: none; }
  .tab-content.active { display: block; }

  .marker { color: var(--accent); font-weight: 700; }
  .strikethrough { text-decoration: line-through; color: var(--muted); }
</style>
</head>
