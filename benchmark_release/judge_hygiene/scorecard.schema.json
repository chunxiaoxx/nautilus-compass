{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Judge-Hygiene Scorecard",
  "description": "Machine-readable scorecard required by PROTOCOL v1.0 §1.3. A submission missing required fields is not accepted into comparisons.",
  "type": "object",
  "required": ["system", "benchmark", "calibers", "judge", "subject", "retrieval", "rejudge_verified", "evaluated_at", "protocol_version"],
  "properties": {
    "system": {
      "type": "object", "required": ["name", "version", "code_url"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "code_url": {"type": "string", "format": "uri"}
      }
    },
    "benchmark": {
      "type": "object", "required": ["name", "tier", "domains"],
      "properties": {
        "name": {"type": "string", "examples": ["LongMemEval-V2"]},
        "tier": {"type": "string", "enum": ["small", "medium"]},
        "domains": {"type": "array", "items": {"enum": ["web", "enterprise"]}}
      }
    },
    "calibers": {
      "type": "object", "required": ["full", "non_abstention"],
      "description": "Dual-caliber reporting is MANDATORY (§1.2).",
      "properties": {
        "full": {
          "type": "object", "required": ["overall", "n"],
          "properties": {
            "overall": {"type": "number", "minimum": 0, "maximum": 1},
            "n": {"type": "integer"},
            "by_type": {"type": "object"}
          }
        },
        "non_abstention": {
          "type": "object", "required": ["overall", "n"],
          "properties": {
            "overall": {"type": "number", "minimum": 0, "maximum": 1},
            "n": {"type": "integer"},
            "by_type": {"type": "object"}
          }
        }
      }
    },
    "judge": {
      "type": "object", "required": ["model", "max_completion_tokens", "reasoning_effort", "structure"],
      "properties": {
        "model": {"type": "string"},
        "max_completion_tokens": {"type": "integer", "minimum": 16384, "description": "§1.1 floor — smaller values reject the scorecard"},
        "reasoning_effort": {"type": "string", "examples": ["low", "medium", "disabled"]},
        "structure": {"type": "string", "enum": ["all_llm", "programmatic_plus_llm"], "description": "all_llm = every question LLM-judged; programmatic_plus_llm = deterministic scoring for structured answers, LLM only where semantics needed (the upstream reference structure)"}
      }
    },
    "subject": {
      "type": "object", "required": ["reader_model", "temperature", "context_budget_tokens"],
      "properties": {
        "reader_model": {"type": "string"},
        "temperature": {"type": "number"},
        "context_budget_tokens": {"type": "integer", "description": "Memory-context truncation budget. Must be reported — 24k vs 200k is not comparable (our own lesson)."},
        "votes": {"type": "integer", "default": 1}
      }
    },
    "retrieval": {
      "type": "object", "required": ["embedder", "unit", "top_k"],
      "properties": {
        "embedder": {"type": "string"},
        "reranker": {"type": ["string", "null"]},
        "unit": {"type": "string", "enum": ["session", "utterance", "state_slice", "trajectory", "pooled_multi_unit"]},
        "top_k": {"type": "integer"},
        "controller_llm": {"type": ["string", "null"], "description": "null = controller-free (our design); non-null systems must report controller latency"}
      }
    },
    "latency": {
      "type": "object",
      "properties": {
        "memory_query_avg_seconds": {"type": "number"}
      }
    },
    "rejudge_verified": {"type": "boolean", "description": "§1.1: whether the run passed a budget-corrected rejudge pass"},
    "evaluated_at": {"type": "string", "format": "date"},
    "contamination_declaration": {"type": "string", "description": "§1.5: training-data overlap with benchmark sources, if any"},
    "protocol_version": {"type": "string", "const": "1.0"}
  }
}
