diff --git a/test_issue.py b/test_issue.py
new file mode 100644
index 0000000000..c6c4205f9a
--- /dev/null
+++ b/test_issue.py
@@ -0,0 +1,50 @@
+import os
+import sys
+sys.path.insert(0, ".")
+os.environ["DJANGO_SETTINGS_MODULE"] = "test_settings"
+
+with open("test_settings.py", "w") as f:
+    f.write("SECRET_KEY = \"test-secret-key\"")
+
+import django
+django.setup()
+
+from django.db import connection, models
+from django.utils.functional import SimpleLazyObject, lazy
+
+class Artist(models.Model):
+    name = models.CharField(max_length=100)
+    class Meta:
+        app_label = "test_app"
+
+with connection.schema_editor() as schema_editor:
+    schema_editor.create_model(Artist)
+
+artist = Artist.objects.create(name="Rene Magritte")
+
+print("Testing SimpleLazyObject:")
+lazy_obj = SimpleLazyObject(lambda: "Rene Magritte")
+print("Type:", type(lazy_obj))
+print("Is string:", isinstance(lazy_obj, str))
+
+print()
+print("Testing lazy():")
+lazy_str = lazy(lambda: "Rene Magritte", str)()
+print("Type:", type(lazy_str))
+print("Is string:", isinstance(lazy_str, str))
+
+print()
+print("Filtering with SimpleLazyObject:")
+try:
+    result = Artist.objects.get(name=lazy_obj)
+    print("Success:", result)
+except Exception as e:
+    print("Error:", type(e).__name__, str(e))
+
+print()
+print("Filtering with lazy():")
+try:
+    result = Artist.objects.get(name=lazy_str)
+    print("Success:", result)
+except Exception as e:
+    print("Error:", type(e).__name__, str(e))
