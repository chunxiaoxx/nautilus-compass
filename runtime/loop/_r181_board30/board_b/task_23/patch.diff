+def make_redirect_handler_infinite_head(support_get=True):
+    """Handler that creates infinite redirect loop on HEAD but works with GET."""
+    class InfiniteRedirectHeadHandler(http.server.BaseHTTPRequestHandler):
+        def do_HEAD(self):
+            if support_get:
+                self.send_response(405, "Method Not Allowed")
+            else:
+                self.send_response(302, "Found")
+                self.send_header("Location", "http://localhost:7777/")
+            self.end_headers()
+
+        def do_GET(self):
+            self.send_response(200, "OK")
+            self.end_headers()
+            self.wfile.write(b"ok
+")
+
+        def log_date_time_string(self):
+            return ""
+
+    return InfiniteRedirectHeadHandler
+
+
+@pytest.mark.sphinx('linkcheck', testroot='linkcheck-localserver', freshenv=True)
+def test_too_many_redirects_on_HEAD_fallback_to_GET(app, capsys):
+    """Test that TooManyRedirects on HEAD falls back to GET request."""
+    with http_server(make_redirect_handler_infinite_head(support_get=True)):
+        app.builder.build_all()
+    stdout, stderr = capsys.readouterr()
+    content = (app.outdir / 'output.txt').read_text()
+    assert content == ""
+    assert '"HEAD / HTTP/1.1" 405' in stderr
+    assert '"GET / HTTP/1.1" 200' in stderr