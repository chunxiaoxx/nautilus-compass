[Unit]
Description=Nautilus Compass · gateway + BGE daemon
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/nautilus-compass
Environment=PYTHONUNBUFFERED=1
# COMPASS_PG_DSN must be supplied by the deployment-owned environment file.
EnvironmentFile=-/etc/nautilus/compass-gateway.env
Environment=COMPASS_AUTH_BACKEND=pg
Environment=COMPASS_TRUST_TENANT_HEADER=0
Environment=COMPASS_DEMO_RPH=20
EnvironmentFile=-/home/ubuntu/nautilus-mvp/phase3/backend/.env
ExecStart=/home/ubuntu/nautilus-compass/ops/start.sh
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/ubuntu/nautilus-compass/.cache/service.log
StandardError=append:/home/ubuntu/nautilus-compass/.cache/service.log

[Install]
WantedBy=multi-user.target
