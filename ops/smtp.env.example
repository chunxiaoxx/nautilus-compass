# v1.4 followup · #106 · SMTP creds template for marketing email channel
#
# Platform-marketing writer has 'email' channel · 1 approved post is stuck
# (published_at NULL · no SMTP creds · no recipient resolution).
#
# Install:
#   ssh cloud
#   cp /home/ubuntu/nautilus-compass/ops/smtp.env.example /home/ubuntu/nautilus-v5/.env.smtp
#   vi /home/ubuntu/nautilus-v5/.env.smtp    # fill in real values
#   chmod 600 /home/ubuntu/nautilus-v5/.env.smtp
#
# Then in marketing-cron service unit · add:
#   EnvironmentFile=/home/ubuntu/nautilus-v5/.env.smtp
#
# Provider options:
#   1) Resend (recommended · API + SMTP both work · 100/day free)
#   2) Sendgrid (90-day free tier · 100/day)
#   3) Gmail App Password (2FA required · 500/day limit · personal-volume)
#   4) Self-hosted Postfix (more work · full control)

# ─── Provider 1 · Resend (api.resend.com) · simplest ─────────────────────
RESEND_API_KEY=re_xxx_change_me
EMAIL_FROM_RESEND=outreach@yourdomain.com
EMAIL_FROM_NAME=Nautilus Compass

# ─── Provider 2 · Sendgrid ───────────────────────────────────────────────
# SENDGRID_API_KEY=SG.xxx_change_me
# EMAIL_FROM_SENDGRID=outreach@yourdomain.com

# ─── Provider 3 · SMTP (Gmail/Postfix/Resend SMTP) ───────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_xxx_change_me
SMTP_TLS=true
SMTP_FROM=outreach@yourdomain.com

# ─── Outreach guardrails (规避被标 spam) ────────────────────────────────
EMAIL_RATE_LIMIT_PER_DOMAIN_PER_DAY=3
EMAIL_RATE_LIMIT_TOTAL_PER_HOUR=20
EMAIL_DRY_RUN=false   # set true to log without sending · debug only
EMAIL_REQUIRE_TELEGRAM_APPROVE=true  # /approve gate before send

# ─── Bounce / unsubscribe handling ─────────────────────────────────────
EMAIL_BOUNCE_WEBHOOK_URL=
EMAIL_UNSUBSCRIBE_LIST=/var/lib/compass/email_unsubscribed.txt
