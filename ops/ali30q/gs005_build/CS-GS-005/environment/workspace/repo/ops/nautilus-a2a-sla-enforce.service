[Unit]
Description=Nautilus A2A SLA enforce cron · scan expired unreplied messages · reputation penalty + sender alert
Documentation=file:///home/ubuntu/nautilus-mvp/docs/DEPLOY_SOP_2026_05_19_evening.md
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/nautilus/cron
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/nautilus/cron.env
ExecStart=/usr/bin/python3 /opt/nautilus/cron/enforce_a2a_sla_cron.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=120
# 真 5min interval 真 enough(see .timer)· 真 no Restart

[Install]
WantedBy=multi-user.target
