# gen_sub 配置模板 · 复制到 ~/.config/nautilus/egress.env 并 chmod 600 · 含凭据绝不进仓
SUB_URL=https://你的订阅地址?target=clash
# 或本地测试: SUB_URL_FILE=/tmp/sample_clash.yaml

HOME_HOST=美国家宽IP
HOME_PORT=1080
HOME_USER=
HOME_PASS=

# 可选: 指定前置 VPN 节点名(订阅里的节点);缺省自动选第一个可用节点
# PREPROXY_NAME=香港-01

# 可选: 输出路径(缺省 ~/.config/nautilus/out/merged_sub.yaml)
# OUT=
